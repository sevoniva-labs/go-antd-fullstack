{
  "name": "sevoniva-forge-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "api:types": "openapi-typescript ../api/openapi.yaml -o src/api/generated.d.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/pro-components": "3.1.14-6",
    "@tanstack/react-query": "5.101.4",
    "antd": "6.6.0",
    "dayjs": "1.11.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "openapi-typescript": "7.10.1",
    "oxlint": "1.75.0",
    "typescript": "6.0.2",
    "vite": "8.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "jsdom": "27.2.0",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
