# Core bootstrap (required at startup for first run)
FORGE_BOOTSTRAP_ADMIN=admin
FORGE_BOOTSTRAP_PASSWORD=<set one-time strong password>

# Secret handling: prefer *_FILE, plain env only for bootstrapping/dev.
FORGE_CRYPTO_KEY=<at least 32-byte base64/plain key>

# Signed base images mirrored into the enterprise Harbor. Digest is mandatory.
FORGE_NODE_IMAGE=registry.example.cn/base/node@sha256:<64-lowercase-hex>
FORGE_GO_IMAGE=registry.example.cn/base/golang@sha256:<64-lowercase-hex>
FORGE_RUNTIME_IMAGE=registry.example.cn/base/forge-runtime@sha256:<64-lowercase-hex>

# Database
FORGE_DATABASE_DSN=postgres://forge:forge_dev@postgres:5432/forge?sslmode=disable
FORGE_DATABASE_READONLY_DSN=

# Cache
FORGE_CACHE_PROVIDER=memory
FORGE_REDIS_ADDRESSES=

# Messaging / Search
FORGE_MESSAGING_PROVIDER=disabled
FORGE_SEARCH_PROVIDER=disabled
FORGE_KAFKA_BROKERS=
FORGE_SEARCH_URLS=

# Storage - support any S3-compatible object storage, not just MinIO
FORGE_STORAGE_PROVIDER=local
# FORGE_STORAGE_PROVIDER=s3
# FORGE_STORAGE_PROVIDER=minio      # MinIO
# FORGE_STORAGE_PROVIDER=cos        # 腾讯云 COS
# FORGE_STORAGE_PROVIDER=oss        # 阿里云 OSS
# FORGE_STORAGE_PROVIDER=ceph-rgw   # Ceph RGW
# FORGE_STORAGE_PROVIDER=obs        # 华为云 OBS
# FORGE_STORAGE_ENDPOINT=http://s3:9000
# FORGE_STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# FORGE_STORAGE_PATH_STYLE=true      # MinIO/Ceph 通常 true，AWS S3 常用 false
FORGE_STORAGE_REGION=us-east-1
FORGE_STORAGE_BUCKET=forge
FORGE_STORAGE_PATH_STYLE=true
FORGE_STORAGE_TLS=false
# For compose templates that include the optional S3 bucket bootstrap helper:
# true: create bucket during stack startup
# false: keep bucket lifecycle in external S3 platform (COS/OSS/R2/etc.)
S3_BUCKET_AUTO_CREATE=true
FORGE_STORAGE_ACCESS_KEY=
FORGE_STORAGE_SECRET_KEY=

# Nacos
FORGE_DISCOVERY_PROVIDER=disabled
FORGE_REMOTE_CONFIG_PROVIDER=disabled
FORGE_NACOS_SERVERS=
FORGE_NACOS_NAMESPACE=
FORGE_NACOS_GROUP=DEFAULT_GROUP
FORGE_NACOS_CLUSTER=DEFAULT
FORGE_NACOS_TLS_REQUIRED=false
FORGE_NACOS_TLS_CA_FILE=
FORGE_NACOS_TLS_CERT_FILE=
FORGE_NACOS_TLS_KEY_FILE=
FORGE_NACOS_TLS_SERVER_NAME=
FORGE_NACOS_CONFIG_GROUP=DEFAULT_GROUP
FORGE_NACOS_CONFIG_DATA_ID=

# Security
FORGE_ALLOWED_ORIGINS=
FORGE_TRUSTED_PROXIES=
FORGE_LOGIN_MAX_FAILURES=5
FORGE_LOGIN_LOCK_DURATION=30m
FORGE_SESSION_TTL=12h
FORGE_PASSWORD_MIN_LENGTH=12
FORGE_PASSWORD_REQUIRE_UPPER=true
FORGE_PASSWORD_REQUIRE_LOWER=true
FORGE_PASSWORD_REQUIRE_DIGIT=true
FORGE_PASSWORD_REQUIRE_SYMBOL=true
FORGE_PASSWORD_HISTORY=5
FORGE_PASSWORD_MAX_AGE_DAYS=90

# Compliance / retention policy
FORGE_COMPLIANCE_PROFILE=mlps3
FORGE_AUDIT_RETENTION_DAYS=365
FORGE_NETWORK_LOG_RETENTION_DAYS=183

# Server / app
FORGE_ENV=production
FORGE_REGION=cn-north
FORGE_ZONE=zone-a
FORGE_PUBLIC_URL=https://forge.example.com
FORGE_WEB_DIR=/app/web
FORGE_SECURE_COOKIES=true
FORGE_SAME_SITE=lax
